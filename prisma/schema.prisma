// Handa Backend — Database Schema
// Covers the Handa app: live "Shop For Me" video shopping, home cooks,
// event planners, an AI meal planner, and the riders / independent
// shoppers who fulfill deliveries and shopping sessions.
//
// Money is stored as Int in kobo (1 NGN = 100 kobo) throughout, matching
// Paystack's own API units and avoiding float rounding — same convention
// as passnow-backend-new's Payment.amountKobo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// IDENTITY & ACCESS CONTROL
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  VENDOR // home cook / event planner
  RIDER
  SHOPPER // independent live shopper for "Shop For Me" sessions
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String?       @unique
  phone        String?       @unique
  passwordHash String? // null for guest accounts
  isGuest      Boolean       @default(false)
  role         Role          @default(CUSTOMER)
  status       AccountStatus @default(ACTIVE)
  avatarUrl    String?

  // Only meaningful when role=ADMIN — gates admin-management endpoints,
  // analytics, and rider-session monitoring away from ordinary admins.
  // Provisioned once via migration backfill, not settable through the API.
  isSuperAdmin Boolean @default(false)

  // Only meaningful when role=ADMIN — a middle tier (set via super admin's
  // "Add Admin" form, see adminManagement.controller.js) that can view the
  // same analytics/monitoring/settings screens as a super admin but can't
  // perform the sensitive write actions (manage other admins, view the
  // audit log, save Code Editor/Codes changes, send announcements, edit
  // app settings or subscriptions). isSuperAdmin always implies full access
  // regardless of this flag.
  isContentAdmin Boolean @default(false)

  address String?
  state   String?
  lga     String?
  lat     Float?
  lng     Float?

  // Shared bank-account fields — every payable role (vendor/rider/shopper)
  // withdraws to the same one linked account, matching the frontend's
  // single bankName+bankAcct pair per user (no per-role duplication there).
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String? // resolved via Paystack NUBAN lookup at link time, not typed freely

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  refreshTokens          RefreshToken[]
  addresses              Address[]
  vendorProfile          VendorProfile?
  riderProfile           RiderProfile?
  shopperProfile         ShopperProfile?
  wallet                 Wallet?
  savedPaymentMethods    SavedPaymentMethod[]
  bookingsAsCustomer     Booking[]               @relation("BookingCustomer")
  shopSessionsAsCustomer ShopSession[]           @relation("ShopSessionCustomer")
  registeredSellers      RegisteredSeller[]
  ratingsGiven           Rating[]                @relation("RatingRater")
  ratingsReceived        Rating[]                @relation("RatingRatee")
  supportTickets         SupportTicket[]
  notifications          Notification[]
  notificationPref       NotificationPreference?
  chatParticipants       ChatParticipant[]
  chatMessages           ChatMessage[]
  kycDocuments           KycDocument[]
  eventRequests          EventRequest[]
  favourites             Favourite[]
  appSettingsUpdated     AppSetting[]
  aiConversations        AiConversationLog[]

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Saved delivery addresses, distinct from the single "home" address on User.
model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // "Home", "Office", ...
  line      String
  state     String?
  lga       String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// ROLE PROFILES
// ─────────────────────────────────────────────────────────────────────────

enum VendorType {
  HOME_COOK
  EVENT_PLANNER
}

model VendorProfile {
  id     String     @id @default(uuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vtype  VendorType

  bizName     String
  description String?
  bio         String?
  emoji       String? // icon shown in the catalog card
  bannerColor String?
  tags        String[] @default([]) // cuisine tags / specialties / service tags
  languages   String[] @default([])

  isOnline    Boolean @default(false) // "Go Online" toggle — receives new order broadcasts when true
  isVerified  Boolean @default(false)
  ratingAvg   Float   @default(0)
  ratingCount Int     @default(0)

  minOrderKobo        Int     @default(0)
  baseDeliveryFeeKobo Int     @default(40000) // ₦400 base, matches frontend
  prepTimeMinutes     Int? // typical prep/response time shown on cards
  hourlyRateKobo      Int? // home cooks: rate for a cooking session
  ratePeriod          String? // e.g. "per hour", "per event" — home cook / event planner

  featuredUntil DateTime? // active "Get Featured" boost expiry
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  menuItems         MenuItem[]
  servicePackages   ServicePackage[]
  bookingsReceived  Booking[]          @relation("BookingVendor")
  shopSessionStore  ShopSession[]      @relation("ShopSessionStore")
  featureBoosts     FeatureBoost[]
  commissionPeriods CommissionPeriod[]
  eventProposals    EventProposal[]

  @@index([vtype])
  @@index([isOnline])
}

model RiderProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleType String? // "Motorcycle", "Bicycle", "Car"...
  plateNumber String?

  isOnline    Boolean @default(false)
  isVerified  Boolean @default(false)
  ratingAvg   Float   @default(0)
  ratingCount Int     @default(0)
  deliveries  Int     @default(0)
  acceptRate  Float   @default(0) // percent, 0-100

  currentLat        Float?
  currentLng        Float?
  locationUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shopSessionsAsRider ShopSession[] @relation("ShopSessionRider")

  @@index([isOnline])
}

model ShopperProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  market      String? // usual market they shop from
  specialties String[] @default([])

  isOnline    Boolean @default(false)
  isVerified  Boolean @default(false)
  ratingAvg   Float   @default(0)
  ratingCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shopSessions ShopSession[] @relation("ShopSessionShopper")

  @@index([isOnline])
}

// Manual document review — vendors/riders/shoppers each submit whichever
// KYC doc types apply to them (see kyc.controller.js for the per-role
// set); admin approves/rejects each one, then separately flips the
// profile's own isVerified flag once satisfied (same two-step review the
// frontend's admin panel already does for vendors, extended here to
// riders/shoppers and backed by a real uploaded document instead of a
// bare toggle).
enum KycDocType {
  GOVERNMENT_ID
  PROOF_OF_ADDRESS
  VEHICLE_DOCUMENT
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

model KycDocument {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  docType         KycDocType
  fileUrl         String
  status          KycStatus  @default(PENDING)
  rejectionReason String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([userId])
}

// Market sellers a shopper buys from during a session — paid directly out
// of session escrow at handover, not through the platform catalog.
model RegisteredSeller {
  id                String   @id @default(uuid())
  shopperId         String
  shopper           User     @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  name              String
  phone             String
  market            String?
  bankName          String
  bankCode          String? // Paystack bank code — needed again at payout time for createTransferRecipient(); nullable so older rows created before this field existed don't break
  bankAccountNumber String
  bankAccountName   String
  createdAt         DateTime @default(now())

  payouts SellerPayout[]

  @@index([shopperId])
}

// ─────────────────────────────────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────────────────────────────────

// Cook specials sold by HOME_COOK vendors — real menu items the customer
// picks from during a booking.
model MenuItem {
  id       String        @id @default(uuid())
  vendorId String
  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  emoji           String?
  imageUrl        String?
  category        String?
  priceKobo       Int
  prepTimeMinutes Int?
  popular         Boolean @default(false)
  inStock         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([vendorId, category])
}

enum PackageKey {
  BASIC
  STANDARD
  PREMIUM
  WEDDING
  CORPORATE
  BIRTHDAY
  BURIAL
  NAMING
  CUSTOM // a vendor-defined package outside the fixed template set
}

// Fixed-tier (or CUSTOM) service packages sold by vendors.
model ServicePackage {
  id         String        @id @default(uuid())
  vendorId   String
  vendor     VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  key        PackageKey
  label      String
  priceKobo  Int
  includes   String[]      @default([])
  guestCount Int?
  createdAt  DateTime      @default(now())

  bookings Booking[]

  @@index([vendorId])
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
  WALLET
  CASH_ON_DELIVERY
  POS
}

// ─────────────────────────────────────────────────────────────────────────
// BOOKINGS (home cook / event planning)
// ─────────────────────────────────────────────────────────────────────────

enum BookingType {
  HOME_COOK
  EVENT_PLANNING
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CONFIRMED // deposit paid into escrow
  COMPLETED
  CANCELLED
}

model Booking {
  id            String        @id @default(uuid())
  bookingNumber String        @unique
  type          BookingType
  status        BookingStatus @default(REQUESTED)

  customerId String
  customer   User          @relation("BookingCustomer", fields: [customerId], references: [id])
  vendorId   String
  vendor     VendorProfile @relation("BookingVendor", fields: [vendorId], references: [id])

  servicePackageId String?
  servicePackage   ServicePackage? @relation(fields: [servicePackageId], references: [id])

  // Free-form selected menu items / add-ons, e.g. [{menuItemId, name, qty, priceKobo}]
  selectedItems Json?

  eventDate  DateTime?
  eventTime  String?
  venue      String?
  guestCount Int?
  phone      String?
  notes      String?

  paymentMethod PaymentMethod
  totalKobo     Int

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  // Stamped once each reminder actually goes out, so the sweep never
  // double-sends — null means "not sent yet", not "not due yet".
  reminder24SentAt DateTime?
  reminder2SentAt  DateTime?

  // Two-sided completion: the vendor marks their side done first, then the
  // customer either confirms (both set -> COMPLETED, escrow releases) or
  // disputes (neither the booking's status nor these fields change — a
  // SupportTicket with context BOOKING carries the dispute instead, see
  // completeBooking/confirmBookingCompletion in bookings.controller.js).
  vendorConfirmedCompleteAt   DateTime?
  customerConfirmedCompleteAt DateTime?

  escrowHolds EscrowHold[]
  ratings     Rating[]

  @@index([customerId])
  @@index([vendorId])
  @@index([status])
}

// ── Event proposal / comparison marketplace ────────────────────────────
// A layer on top of Booking, not a replacement for it: a customer posts
// one EventRequest (no vendor picked yet), qualified EVENT_PLANNER vendors
// each submit an EventProposal, and accepting one proposal creates a real
// Booking (status ACCEPTED — the planner already committed to this price
// by proposing, so acceptance is the mutual-agreement point; the customer
// then just pays the deposit like any other booking) and auto-declines
// the rest. Direct single-vendor booking (createBooking above) is
// unchanged and still how home cooks are normally booked.
enum EventRequestStatus {
  OPEN
  PROPOSAL_ACCEPTED
  CANCELLED
}

model EventRequest {
  id         String @id @default(uuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  eventType         String
  eventDate         DateTime
  venue             String
  guestCount        Int?
  budgetKobo        Int?
  servicesRequested String[] @default([])
  notes             String?

  status             EventRequestStatus @default(OPEN)
  acceptedProposalId String?

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  proposals EventProposal[]

  @@index([customerId])
  @@index([status])
}

enum EventProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model EventProposal {
  id             String        @id @default(uuid())
  eventRequestId String
  eventRequest   EventRequest  @relation(fields: [eventRequestId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         VendorProfile @relation(fields: [vendorId], references: [id])

  priceKobo        Int
  servicesIncluded String[] @default([])
  timeline         String?
  notes            String?

  status    EventProposalStatus @default(PENDING)
  createdAt DateTime            @default(now())

  @@index([eventRequestId])
  @@index([vendorId])
}

// ─────────────────────────────────────────────────────────────────────────
// LIVE SHOPPING ("Shop For Me")
// ─────────────────────────────────────────────────────────────────────────

enum ShopSessionStatus {
  SEARCHING // looking for an available shopper
  MATCHED
  BUILDING_LIST
  LIVE_CALL
  PACKAGING
  FINDING_RIDER
  RIDER_ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

model ShopSession {
  id     String            @id @default(uuid())
  status ShopSessionStatus @default(SEARCHING)

  customerId String
  customer   User            @relation("ShopSessionCustomer", fields: [customerId], references: [id])
  shopperId  String?
  shopper    ShopperProfile? @relation("ShopSessionShopper", fields: [shopperId], references: [id])
  storeId    String? // optional: a specific vendor this session targets (unused today, kept for future use)
  store      VendorProfile?  @relation("ShopSessionStore", fields: [storeId], references: [id])
  riderId    String?
  rider      RiderProfile?   @relation("ShopSessionRider", fields: [riderId], references: [id])

  items ShopSessionItem[]

  sessionFeeKobo Int // tiered by item count: <=5 items ₦3,000 / <=10 ₦4,000 / else ₦5,000
  riderFeeKobo   Int @default(0)
  itemsTotalKobo Int @default(0) // sum of approved items' price, filled in as shopper prices them
  depositKobo    Int @default(0) // total confirmed Paystack payment received for this session (session fee + shopping budget for market sellers)

  deliveryAddress String?
  deliveryLat     Float?
  deliveryLng     Float?

  // Handover confirmation — rider must be told these verbally/in-app by
  // the shopper (pickup) and customer (delivery); never shown on the
  // rider's own screen. See src/utils/otp.js.
  pickupCode   String?
  deliveryCode String?

  // Live-call duration, used to bill the real per-minute session fee
  // (sessionFeeForDuration in shopSessions.controller.js) instead of the
  // old item-count tiering — stamped by the startCall/startPackaging
  // transitions.
  callStartedAt DateTime?
  callEndedAt   DateTime?

  // Real 3-way audio call (rider + shopper + customer) the rider starts
  // once they reach the customer with the delivery — set the moment any
  // of the 3 real parties marks it done. markDelivered requires this to
  // be set first, same gating shape as the pickup/delivery OTP codes.
  confirmCallCompletedAt DateTime?

  createdAt   DateTime  @default(now())
  matchedAt   DateTime?
  deliveredAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  escrowHolds   EscrowHold[]
  sellerPayouts SellerPayout[]
  ratings       Rating[]

  @@index([customerId])
  @@index([shopperId])
  @@index([riderId])
  @@index([status])
}

enum ShopItemAddedBy {
  CUSTOMER
  SHOPPER
}

model ShopSessionItem {
  id         String          @id @default(uuid())
  sessionId  String
  session    ShopSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  text       String // free-text request, e.g. "2kg tomatoes"
  priceKobo  Int? // filled in by the shopper once found in-market
  approved   Boolean         @default(false)
  addedBy    ShopItemAddedBy @default(CUSTOMER)
  createdAt  DateTime        @default(now())
  approvedAt DateTime?

  @@index([sessionId])
}

model SellerPayout {
  id         String           @id @default(uuid())
  sessionId  String
  session    ShopSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     RegisteredSeller @relation(fields: [sellerId], references: [id])
  amountKobo Int
  status     PayoutStatus     @default(PENDING)
  reference  String?
  paidAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([sessionId])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────
// WALLET, ESCROW, WITHDRAWALS, PAYMENTS
// ─────────────────────────────────────────────────────────────────────────

model Wallet {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceKobo Int      @default(0)
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
  withdrawals  Withdrawal[]
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ESCROW_HOLD
  ESCROW_RELEASE
  ESCROW_REFUND
  PAYOUT // e.g. a rider/vendor/shopper receiving a released escrow amount
  COMMISSION_PAYMENT
  FEATURE_BOOST_PAYMENT
  ADJUSTMENT
}

// Generic reference to whatever this transaction/hold is about, since it
// can be a Booking or a ShopSession. ORDER is kept for backward
// compatibility with historical rows but nothing produces it anymore —
// the catalog-checkout Order model was removed along with the GROCERY/
// CATERER/CAKE_DESIGNER vendor types that were its only users.
enum ContextType {
  ORDER
  BOOKING
  SHOP_SESSION
}

model Transaction {
  id               String          @id @default(uuid())
  walletId         String
  wallet           Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type             TransactionType
  amountKobo       Int // positive = credit, negative = debit
  balanceAfterKobo Int
  contextType      ContextType?
  contextId        String?
  reference        String?
  description      String?
  createdAt        DateTime        @default(now())

  @@index([walletId])
  @@index([contextType, contextId])
}

enum EscrowStatus {
  HELD
  RELEASED
  DISPUTED
  REFUNDED
}

enum PayeeRole {
  VENDOR
  RIDER
  SHOPPER
  SELLER
  PLATFORM
}

// One hold per beneficiary so payouts can be released itemized — a
// ShopSession has up to three (session fee to the shopper, delivery fee to
// the rider, item costs to market sellers via SellerPayout).
model EscrowHold {
  id            String       @id @default(uuid())
  contextType   ContextType
  bookingId     String?
  booking       Booking?     @relation(fields: [bookingId], references: [id])
  shopSessionId String?
  shopSession   ShopSession? @relation(fields: [shopSessionId], references: [id])

  payerId    String
  payeeId    String? // null when payeeRole = PLATFORM
  payeeRole  PayeeRole
  amountKobo Int
  status     EscrowStatus @default(HELD)

  autoReleaseAt DateTime?
  releasedAt    DateTime?
  refundedAt    DateTime?
  disputeId     String?

  createdAt DateTime @default(now())

  @@index([contextType, bookingId])
  @@index([contextType, shopSessionId])
  @@index([payerId])
  @@index([payeeId])
  @@index([status])
}

model Withdrawal {
  id                   String           @id @default(uuid())
  userId               String
  walletId             String
  wallet               Wallet           @relation(fields: [walletId], references: [id])
  amountKobo           Int
  bankName             String
  bankAccountNumber    String
  bankAccountName      String
  status               WithdrawalStatus @default(PENDING)
  paystackTransferCode String?
  failureReason        String?
  requestedAt          DateTime         @default(now())
  completedAt          DateTime?

  @@index([userId])
  @@index([status])
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// A tokenized reference to a card, never the raw PAN — mirrors what
// Paystack's charge-authorization flow returns.
model SavedPaymentMethod {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateway           String   @default("paystack")
  authorizationCode String
  cardType          String?
  last4             String?
  expMonth          String?
  expYear           String?
  bank              String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([userId, authorizationCode])
}

// Idempotency log for Paystack webhook deliveries — (reference) unique so a
// duplicate delivery of the same event is a safe no-op.
model PaymentWebhookEvent {
  id          String   @id @default(uuid())
  provider    String   @default("paystack")
  eventRef    String   @unique
  payload     Json
  processedAt DateTime @default(now())
}

model CommissionPeriod {
  id             String           @id @default(uuid())
  vendorId       String
  vendor         VendorProfile    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  amountDueKobo  Int
  amountPaidKobo Int              @default(0)
  status         CommissionStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([vendorId])
}

enum CommissionStatus {
  PENDING
  PAID
  OVERDUE
}

model FeatureBoost {
  id             String        @id @default(uuid())
  vendorId       String
  vendor         VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amountPaidKobo Int
  startAt        DateTime      @default(now())
  endAt          DateTime
  createdAt      DateTime      @default(now())

  @@index([vendorId])
}

// ─────────────────────────────────────────────────────────────────────────
// RATINGS, SUPPORT, NOTIFICATIONS, CHAT
// ─────────────────────────────────────────────────────────────────────────

enum RateeRole {
  VENDOR
  RIDER
  SHOPPER
}

model Rating {
  id            String       @id @default(uuid())
  contextType   ContextType
  bookingId     String?
  booking       Booking?     @relation(fields: [bookingId], references: [id])
  shopSessionId String?
  shopSession   ShopSession? @relation(fields: [shopSessionId], references: [id])

  raterId   String
  rater     User      @relation("RatingRater", fields: [raterId], references: [id])
  rateeId   String
  ratee     User      @relation("RatingRatee", fields: [rateeId], references: [id])
  rateeRole RateeRole

  score   Int // 1-5
  comment String?

  createdAt DateTime @default(now())

  @@unique([bookingId, rateeRole])
  @@unique([shopSessionId, rateeRole])
  @@index([rateeId])
}

enum TicketContext {
  ORDER
  SHOP_SESSION
  RIDER
  VENDOR
  CUSTOMER
  BOOKING
  GENERAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  context     TicketContext
  category    String
  description String?
  contextId   String? // orderId / shopSessionId / riderId etc., loosely typed on purpose
  status      TicketStatus  @default(OPEN)
  resolution  String?
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  // Disputes are support tickets with a money claim attached — same
  // table, extra fields, rather than a parallel model. See
  // src/services/escrow.service.js's disputeHold() for how a HELD hold
  // gets pulled out of the auto-release sweep while one of these is
  // under investigation.
  isDispute           Boolean   @default(false)
  evidenceUrl         String?
  requestedRefundKobo Int?
  refundAmountKobo    Int?
  refundedAt          DateTime?

  // The other party's side of a dispute (e.g. the vendor responding to a
  // customer's "booking not completed" report) — one response, added by
  // whoever ISN'T the ticket's own userId. Admin sees both sides on the
  // one ticket rather than needing to correlate two separate tickets.
  secondPartyResponse    String?
  secondPartyRespondedAt DateTime?

  @@index([userId])
  @@index([status])
}

enum NotificationType {
  ORDER_UPDATE
  PROMOTION
  RIDER_ALERT
  NEW_FEATURE
  CHAT
  SYSTEM
  ANNOUNCEMENT
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model NotificationPreference {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderUpdates Boolean @default(true)
  promotions   Boolean @default(true)
  riderAlerts  Boolean @default(true)
  newFeatures  Boolean @default(true)
}

enum ChatContextType {
  ORDER
  BOOKING
  SHOP_SESSION
  SUPPORT
  DIRECT
}

model ChatThread {
  id          String          @id @default(uuid())
  contextType ChatContextType
  contextId   String?
  createdAt   DateTime        @default(now())

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([contextType, contextId])
}

model ChatParticipant {
  id         String     @id @default(uuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?

  @@unique([threadId, userId])
  @@index([userId])
}

model ChatMessage {
  id            String     @id @default(uuid())
  threadId      String
  thread        ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User       @relation(fields: [senderId], references: [id])
  body          String
  attachmentUrl String?
  createdAt     DateTime   @default(now())

  @@index([threadId])
}

enum FavouriteTargetType {
  VENDOR
  SHOPPER
}

// One model covers cooks, event planners (both VendorProfile, distinguished
// by vtype) and shoppers — a customer favouriting any of the three just
// picks the right targetType. Unique on (userId, targetType, targetId) so
// toggling is idempotent instead of needing the frontend to track state.
model Favourite {
  id         String              @id @default(uuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType FavouriteTargetType
  targetId   String
  createdAt  DateTime            @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

// Super-admin-only trail of sensitive admin actions (admin management,
// verification decisions, dispute refunds, account status changes).
// actorId/actorName/actorEmail are a denormalized snapshot rather than a
// foreign key — an entry stays readable even after the acting admin is
// later removed.
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorName  String
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// A summary row per platform-wide announcement sent (super-admin only) —
// the fan-out itself lands as one Notification per targeted user (type
// ANNOUNCEMENT); this table is just the admin-facing "what did we send
// and to how many people" history, not the delivery mechanism.
model Announcement {
  id             String   @id @default(uuid())
  title          String
  body           String
  targetRoles    String[] @default([])
  sentById       String
  sentByName     String
  recipientCount Int
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// Real SMTP email sent from the admin panel (as opposed to Announcement,
// which only ever creates in-app Notification rows). Recipients can be
// "every active user with an email", an explicit list of user ids, or a
// single user id — recipientEmails records exactly who it went to since
// User rows can later change/lose their email.
model BulkEmail {
  id              String   @id @default(uuid())
  subject         String
  body            String
  recipientEmails String[] @default([])
  sentCount       Int
  failedCount     Int      @default(0)
  sentById        String
  sentByName      String
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

// Generic key/value config store for the admin "App Settings" screen.
// Nothing in the running app reads from this yet — it exists so a super
// admin has somewhere to record/adjust platform config (feature flags,
// thresholds, copy) without needing a code change, ready for real code
// to start consulting it later.
model AppSetting {
  key         String   @id
  value       String // JSON-encoded — string/number/boolean/object
  category    String?
  description String?
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

// Question/answer log for the AI Meal Planner. Nothing produces rows here
// yet — the meal planner is still the frontend's hardcoded demo (no real
// AI provider wired up). This is the infrastructure so the admin viewer
// and a real AI-backed endpoint can both start working the moment an AI
// provider API key is available, without another schema change.
model AiConversationLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt    String
  response  String
  provider  String? // e.g. "GEMINI" | "OPENAI" | "CLAUDE"
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
