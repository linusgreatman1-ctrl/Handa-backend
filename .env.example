# Postgres connection string. Render/Railway free tiers wipe local disk on
# every restart/redeploy, so this must be a real Postgres instance, not sqlite.
DATABASE_URL="postgresql://user:password@localhost:5432/handa?schema=public"

PORT=4000
NODE_ENV=development

# Long random strings — used to sign access/refresh JWTs.
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:4000,http://localhost:5173"

# Paystack (test keys from https://dashboard.paystack.com/#/settings/developers).
# Used for: card/bank checkout on order & booking payments, wallet top-ups,
# NUBAN bank-account resolve on withdrawal setup, and Transfer API payouts
# for withdrawals / market-seller payouts.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Escrow auto-release window if the customer never explicitly confirms
# delivery (matches the frontend prototype's "24h auto-release" copy).
ESCROW_AUTO_RELEASE_HOURS=24

# Platform fee cuts (percent, integer 0-100).
PLATFORM_ORDER_FEE_PERCENT=5
PLATFORM_SHOP_SESSION_FEE_PERCENT=20
VENDOR_COMMISSION_PERCENT=10
FEATURE_BOOST_WEEKLY_NGN=5000

# DEV ONLY — lets every "pay by wallet" step (orders, bookings, shop
# sessions) succeed regardless of balance, so the full app can be clicked
# through end-to-end without needing real Paystack funds first. Every
# transaction is still logged normally, just without the balance check.
# Unset this (or set to "false") before treating the app as production —
# real customers must never be able to spend money they don't have.
DEV_BYPASS_PAYMENTS=true
